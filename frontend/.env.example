# Public URL for the app
# Example: https://yourdomain.com
NEXT_PUBLIC_URL=

# Public backend origin used for /api and /uploads absolute URLs in the browser.
# In production this should be the public backend domain, for example:
# NEXT_PUBLIC_API_URL=https://api.yourdomain.com
# Example: http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000

# Server-side backend URL for Next.js proxy routes
# Example: http://backend:8000
API_URL=http://backend:8000

# Alternatively use NEXT_PUBLIC_API_BASE_URL as the public backend origin.
# Example: http://localhost:8000
# NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
