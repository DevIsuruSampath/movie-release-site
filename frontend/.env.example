# Public URL for the app (e.g., https://yourdomain.com)
NEXT_PUBLIC_URL=

# API URL for backend
NEXT_PUBLIC_API_URL=http://localhost:8000

# Server-side backend URL for Next.js proxy routes
API_URL=http://backend:8000

# Alternatively use NEXT_PUBLIC_API_BASE_URL
# NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
