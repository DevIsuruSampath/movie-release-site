# Database
SUPABASE_DB_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres?sslmode=require
# Optional legacy fallback if you are not using Supabase Postgres:
# DATABASE_URL=postgresql://user:password@localhost:5432/movie_db
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_RECYCLE_SECONDS=1800
DATABASE_POOL_TIMEOUT_SECONDS=30

# Security
SECRET_KEY=your-super-secret-jwt-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
ALLOWED_ORIGINS=["http://localhost:3000"]

# Storage
STORAGE_BACKEND=local
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=10
PUBLIC_SITE_URL=http://localhost:3000

# Supabase (database + optional storage)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_IMAGES_BUCKET=movie-images
SUPABASE_SUBTITLES_BUCKET=movie-subtitles

# Registration Settings
ALLOW_PUBLIC_REGISTRATION=false
ADMIN_REGISTRATION_CODE=your-secret-admin-code-here
