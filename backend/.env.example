# Database
DATABASE_URL=postgresql://user:password@localhost:5432/movie_db

# Security
SECRET_KEY=your-super-secret-jwt-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
ALLOWED_ORIGINS=["http://localhost:3000"]

# Storage (Local file system)
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=10
PUBLIC_SITE_URL=http://localhost:3000

# Telegram
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_BOT_TOKEN=
TELEGRAM_PRIVATE_CHANNEL_ID=
TELEGRAM_BOT_TOKEN_ENCRYPTION_KEY=
TELEGRAM_REQUEST_TIMEOUT=15
TELEGRAM_ENABLED_DEFAULT=false
TELEGRAM_STORAGE_ENABLED_DEFAULT=false
TELEGRAM_STORAGE_MODE_DEFAULT=local_only

# Registration Settings
ALLOW_PUBLIC_REGISTRATION=false
ADMIN_REGISTRATION_CODE=your-secret-admin-code-here
