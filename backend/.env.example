# Database
# Required in most deployments: use the Supabase pooler connection string from Connection Pooling settings.
# Example: postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require
SUPABASE_POOLER_DB_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require
# Optional direct connection. Use only if your runtime supports direct access to db.[YOUR-PROJECT-REF].supabase.co:5432.
# Example: postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres?sslmode=require
SUPABASE_DB_URL=
# Optional fallback if you are not using Supabase Postgres.
# Example: postgresql://user:password@localhost:5432/movie_db
# DATABASE_URL=postgresql://user:password@localhost:5432/movie_db
# Example: 10
DATABASE_POOL_SIZE=10
# Example: 20
DATABASE_MAX_OVERFLOW=20
# Example: 1800
DATABASE_POOL_RECYCLE_SECONDS=1800
# Example: 30
DATABASE_POOL_TIMEOUT_SECONDS=30

# Security
# Example: replace with a long random secret string
SECRET_KEY=your-super-secret-jwt-key-change-this-in-production
# Example: HS256
ALGORITHM=HS256
# Example: 30
ACCESS_TOKEN_EXPIRE_MINUTES=30
# Example: 7
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
# Example: ["http://localhost:3000","https://yourdomain.com"]
ALLOWED_ORIGINS=["http://localhost:3000"]

# Storage
# Example: local or supabase
STORAGE_BACKEND=local
# Example: uploads or /app/uploads
UPLOAD_DIR=uploads
# Example: 10
MAX_FILE_SIZE_MB=10
# Example: http://localhost:3000 or https://yourdomain.com
PUBLIC_SITE_URL=http://localhost:3000

# Supabase (database + optional storage)
# Example: https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_URL=
# Example: eyJ...service-role-key...
SUPABASE_SERVICE_ROLE_KEY=
# Example: movie-images
SUPABASE_IMAGES_BUCKET=movie-images
# Example: movie-subtitles
SUPABASE_SUBTITLES_BUCKET=movie-subtitles

# Registration Settings
# Example: false or true
ALLOW_PUBLIC_REGISTRATION=false
# Example: your-secret-admin-code-here
ADMIN_REGISTRATION_CODE=your-secret-admin-code-here
