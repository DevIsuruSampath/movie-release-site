# Database
# Example: postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres?sslmode=require
SUPABASE_DB_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres?sslmode=require
# Optional fallback if you are not using Supabase Postgres.
# Example: postgresql://user:password@localhost:5432/movie_db
# DATABASE_URL=postgresql://user:password@localhost:5432/movie_db
# Example: 10
DATABASE_POOL_SIZE=10
# Example: 20
DATABASE_MAX_OVERFLOW=20
# Example: 1800
DATABASE_POOL_RECYCLE_SECONDS=1800
# Example: 30
DATABASE_POOL_TIMEOUT_SECONDS=30

# Security
# Example: replace with a long random secret string
SECRET_KEY=your-super-secret-jwt-key-change-this-in-production
# Example: HS256
ALGORITHM=HS256
# Example: 30
ACCESS_TOKEN_EXPIRE_MINUTES=30
# Example: 7
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
# Example: ["http://localhost:3000","https://yourdomain.com"]
ALLOWED_ORIGINS=["http://localhost:3000"]

# Storage
# Example: local or supabase
STORAGE_BACKEND=local
# Example: uploads or /app/uploads
UPLOAD_DIR=uploads
# Example: 10
MAX_FILE_SIZE_MB=10
# Example: http://localhost:3000 or https://yourdomain.com
PUBLIC_SITE_URL=http://localhost:3000

# Supabase (database + optional storage)
# Example: https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_URL=
# Required when STORAGE_BACKEND=supabase.
# Use the server-side service_role key from Supabase Project Settings > API.
# Do not use the publishable/anon key here.
SUPABASE_SERVICE_ROLE_KEY=
# Required bucket name for image uploads when STORAGE_BACKEND=supabase.
# This bucket must already exist in Supabase Storage unless your service role can create it.
# Example: movie-images
SUPABASE_IMAGES_BUCKET=movie-images
# Required bucket name for subtitle uploads when STORAGE_BACKEND=supabase.
# Example: movie-subtitles
SUPABASE_SUBTITLES_BUCKET=movie-subtitles

# Optional runtime behavior:
# If Supabase storage upload fails, the app may fall back to local /uploads URLs.
# In production, make sure your frontend can reach backend /uploads paths, or fix the Supabase bucket setup.

# Registration Settings
# Example: false or true
ALLOW_PUBLIC_REGISTRATION=false
# Example: your-secret-admin-code-here
ADMIN_REGISTRATION_CODE=your-secret-admin-code-here
